# Local development configuration. Copied to `.env`, which is gitignored.
#
# Every variable here is inlined into the app binary at build time. Nothing in this file is a
# secret, because everything in it is designed to be readable by anyone holding the app.

# ── Supabase ──────────────────────────────────────────────────────────────────
# `sb_publishable_…` is RLS-scoped: it grants nothing on its own, it is only ever paired with the
# RLS policies in the database. Safe to ship. The `service_role` key is NOT — it bypasses RLS on
# every table and belongs in a Cloudflare Worker, never in a phone.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_…>

# ── PostHog ───────────────────────────────────────────────────────────────────
# `phc_…` is a write-only project key. Anyone holding it can send events, which is the same
# exposure as the publishable Supabase key. The read key (`phx_…`) is what the MCP server uses and
# must never appear here or in the app.
#
# Leaving this unset disables analytics entirely — capture becomes a no-op rather than a crash,
# because an unconfigured analytics key must not stop someone ordering food.
EXPO_PUBLIC_POSTHOG_KEY=<phc_…>

# US region is the default. A EU-hosted project uses https://eu.i.posthog.com.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Database checks (not shipped to the app) ──────────────────────────────────
# Direct connection. IPv6-ONLY on Supabase — if the host does not resolve, use the pooler string
# from the dashboard (Project Settings > Database > Connection string > Session pooler, port 6543).
SUPABASE_DB_URL=<your-postgres-connection-string>