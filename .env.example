# Copy to .env and fill in. `.env` is gitignored; this file is not, so it carries names only.
#
# `npm run verify` runs `scripts/check-policies.mjs`, which reads the live database to check
# three rules: no bare `auth.uid()` in a policy, no unpinned `search_path` on a `security definer`
# function, and no unindexed foreign key. Without this variable the check exits 2 — "unchecked" —
# and never 0. That is deliberate: a verify that reports green while having skipped the only
# database-reading step is the failure mode the check exists to prevent.

# Direct connection. IPv6-ONLY on Supabase — if the host does not resolve, use the pooler string
# from the dashboard (Project Settings > Database > Connection string > Session pooler, port 6543).
SUPABASE_DB_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Fallback, read only if SUPABASE_DB_URL is unset.
# DATABASE_URL=
