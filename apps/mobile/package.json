{
  "name": "@marketak/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src app",
    "align": "expo install --check"
  },
  "dependencies": {
    "@expo-google-fonts/material-symbols-sharp": "^0.4.61",
    "@expo/vector-icons": "^15.1.1",
    "@marketak/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "expo": "^57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "^57.0.21",
    "expo-font": "^57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "^57.0.12",
    "expo-localization": "^57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "^57.0.25",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "^57.0.1",
    "expo-system-ui": "^57.0.4",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "tamagui": "^2.7.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.14",
    "dependency-cruiser": "^18.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "comments": {
    "typecheck": "`tsc --noEmit` rather than `tsc -b`: the app emits nothing. The declaration output lives in packages/shared, and `tsc --build` at the root walks the project reference that produces it.",
    "align": "`expo install --check` reports a package the SDK disagrees with. Expo packages are versioned to the SDK, so a hand-bumped `expo-router` is the one breakage that costs an afternoon."
  }
}
