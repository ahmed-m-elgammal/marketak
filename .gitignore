# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.cer
*.certSigningRequest
*.pvk
service-account*.json
firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# Apple App Store Connect — the API key can mint credentials, revoke builds and
# read sales. Treat the .p8 as a live secret even though it "never expires".
appstore/*.p8
appstore/*.cer
appstore/*.mobileprovision
appstore/*.p12

# Android SQLCipher key material, if ever extracted
*.db-journal
*.keystore
!debug.keystore

# Node
node_modules/
.pnpm-store/
npm-debug.log*
yarn-error.log*
.npm/

# Build output
dist/
build/
.next/
out/
.expo/
*.tsbuildinfo
web-build/

# Cloudflare / Supabase local state (contains secrets)
.wrangler/
.dev.vars
supabase/.branches/
supabase/.temp/
supabase/.env

# Native / mobile
*.ipa
*.aab
*.apk
*.aab
Pods/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
android/app/build/
ios/build/
ios/Pods/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp

# Logs and coverage
*.log
logs/
coverage/
.pgtest/